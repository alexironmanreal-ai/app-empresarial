{
  "name": "sentinel-hq",
  "productName": "Sentinel HQ",
  "version": "1.1.0",
  "private": true,
  "description": "Sentinel HQ — escritorio del CEO",
  "author": "Sentinel",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 8080",
    "build": "vite build",
    "preview": "vite preview --port 8080",
    "electron:dev": "concurrently -k \"vite --host --port 8080\" \"wait-on http://localhost:8080 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:linux": "vite build && electron-builder --linux",
    "electron:build:all": "vite build && electron-builder --win --linux",
    "electron:installer": "vite build && electron-builder --win nsis",
    "electron:installer:linux": "vite build && electron-builder --linux AppImage deb",
    "electron:build:dir": "vite build && electron-builder --win --dir",
    "electron:build:dir:linux": "vite build && electron-builder --linux --dir",
    "dist:win": "vite build && electron-builder --win nsis portable",
    "dist:linux": "vite build && electron-builder --linux AppImage deb",
    "dist:all": "vite build && electron-builder --win nsis portable --linux AppImage deb"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.sentinel.hq",
    "productName": "Sentinel HQ",
    "copyright": "Copyright © Sentinel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "Sentinel <sentinel@local>",
      "vendor": "Sentinel",
      "synopsis": "Sentinel HQ — escritorio del CEO",
      "description": "Escritorio del CEO: empresa, finanzas, YouTube, pipeline, OS y cadencia. Cuentas locales multi-usuario.",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "Sentinel HQ",
        "Comment": "Escritorio del CEO",
        "Categories": "Office;Finance;"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sentinel HQ",
      "installerIcon": null,
      "uninstallerIcon": null,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
